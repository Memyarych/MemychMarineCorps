ent-CMFence = забор
    .desc = Большая металлическая сетка, натянутая между двумя столбами. Задумана как дешёвый способ разделить участки, позволяя при этом видеть сквозь неё.
ent-RMCFenceBroken = сломанный забор
    .desc = Груда порванной проволоки, натянутой между двумя столбами; она никому не мешает пройти.
ent-RMCFenceHybrisa = { ent-CMFence }
    .desc = { ent-CMFence.desc }
ent-RMCFenceHybrisaBroken = { ent-RMCFenceBroken }
    .desc = { ent-RMCFenceBroken.desc }
ent-RMCFenceHybrisaElectric = { ent-CMFence }
    .desc = { ent-CMFence.desc }
    .suffix = Электрический
ent-RMCFenceHybrisaElectricBroken = { ent-RMCFenceBroken }
    .desc = { ent-RMCFenceBroken.desc }
    .suffix = Электрический
ent-RMCFenceOvergrown = заросший забор
    .desc = Большая металлическая сетка, натянутая между двумя столбами, опутанная лианами и ползучей порослью. Всё ещё разделяет участки, но природа забирает своё.
ent-RMCFenceOvergrownBroken = сломанный заросший забор
    .desc = Груда порванной проволоки и ползучих сорняков, натянутых между двумя столбами, поглощённая годами неконтролируемого роста.
ent-RMCFenceSPP = { ent-CMFence }
    .desc = { ent-CMFence.desc }
    .suffix = СПН
ent-RMCFenceSPPBroken = { ent-RMCFenceBroken }
    .desc = { ent-RMCFenceBroken.desc }
    .suffix = СПН