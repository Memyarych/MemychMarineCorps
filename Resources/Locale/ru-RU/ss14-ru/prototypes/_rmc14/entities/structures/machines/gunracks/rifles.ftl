ent-RMCGunRackM54CEmpty = стойка для винтовок M54C
    .desc = Оружейная стойка производства AEGIS для хранения длинноствольного оружия. Хотя изначальная модель должна была быть чрезвычайно модифицируемой, КМП ООН заказал стойки с фиксированными слотами, подходящими только для винтовок M54C. Некоторые говорят, что они были дешевле, а некоторые — что главной причиной была способность морпехов легко сломать всё, что сложнее вольфрамового шара.
    .suffix = M54C, Пустая
ent-RMCGunRackM54CFilled = { ent-RMCGunRackM54CEmpty }
    .desc = { ent-RMCGunRackM54CEmpty.desc }
    .suffix = M54C, Заполнена
