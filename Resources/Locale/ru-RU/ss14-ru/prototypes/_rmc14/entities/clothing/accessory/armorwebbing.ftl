ent-RMCArmorWebbingBase = бронеразгрузка
    .desc = { ent-BaseItem.desc }
    .suffix = PVE
ent-RMCArmorWebbingDrum = бронеразгрузка под барабаны
    .desc = Коричневая разгрузка с парой крупных подсумков, вмещающих барабанные магазины большой ёмкости и другие крупные магазины.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingMag = бронеразгрузка под магазины
    .desc = Коричневая разгрузка с четырьмя подсумками под магазины.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingGrenade = бронеразгрузка под гранаты
    .desc = Коричневая разгрузка с рядом небольших подсумков, вмещающих до 6 гранат.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingPouch = универсальная бронеразгрузка
    .desc = Коричневая разгрузка с несколькими небольшими подсумками для различных мелких предметов.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingShell = бронеразгрузка под патроны
    .desc = Коричневая разгрузка с рядом петель, предназначенных для свободных ружейных патронов.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingDrumRCM = бронеразгрузка MOLS под барабаны
    .desc = Комплект разгрузки MOLS образца L1, доработанный для крепления на модульный жилет Kestrel образца L3. Имеет пару крупных подсумков, вмещающих барабанные магазины большой ёмкости и другие крупные магазины.
    .suffix = PVE, Royal
