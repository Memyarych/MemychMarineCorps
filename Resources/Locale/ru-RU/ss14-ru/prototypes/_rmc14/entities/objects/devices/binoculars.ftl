ent-RMCBinoculars = бинокль
    .desc = Военный бинокль.
    .suffix = RMC
ent-RMCBinocularsPVE = тактический монокуляр
    .desc = Военный монокуляр.
    .suffix = PVE
ent-RMCBinocularsCiv = бинокль
    .desc = Бинокль.
    .suffix = { ent-RMCBinoculars.suffix }
ent-RMCBinocularsCivPVE = { ent-RMCBinocularsCiv }
    .desc = { ent-RMCBinocularsCiv.desc }
    .suffix = PVE
ent-RMCRangefinder = дальномер
    .desc = Бинокль с функцией определения дальности. Нажми на клетку, чтобы получить её координаты.
    .suffix = { ent-RMCBinoculars.suffix }
ent-RMCLaserDesignator = лазерный целеуказатель
    .desc = Лазерный целеуказатель с двумя режимами: маркировка цели для CAS с помощью ИК-лазера и определение дальности. Нажми на клетку, чтобы навести на что-нибудь.
    .suffix = { ent-RMCRangefinder.suffix }
ent-RMCLaserDesignatorPVE = тактический монокуляр-целеуказатель
    .desc = Двухрежимный тактический монокуляр, разработанный для использования вместе с элементами CAS и орбитальной поддержки. Нажми на клетку, чтобы навести на что-нибудь.
    .suffix = PVE
ent-RMCLaserDesignatorSpotter = лазерный целеуказатель корректировщика
    .desc = Специально разработанный лазерный целеуказатель, выдаваемый корректировщикам КМП ООН, с двумя режимами: маркировка цели для CAS с помощью ИК-лазера и определение дальности. Нажми на клетку, чтобы навести на что-нибудь. Кроме того, обученный корректировщик может подсвечивать цели для снайпера КМП ООН, ускоряя захват цели. Целеуказательный луч соединит бинокль с целью, но может унаследовать маскировку пользователя, если это возможно.
    .suffix = { ent-RMCRangefinder.suffix }
ent-RMCLaserDesignatorScout = лазерный целеуказатель разведчика
    .desc = Улучшенный лазерный целеуказатель, выдаваемый разведчикам КМП ООН, с двумя режимами: маркировка цели для CAS с помощью ИК-лазера и определение дальности. Нажми на клетку, чтобы навести на что-нибудь.
    .suffix = { ent-RMCLaserDesignator.suffix }
ent-RMCRangefinderTarget = лазер
    .desc = { "" }
ent-RMCLaserDesignatorTarget = { ent-RMCRangefinderTarget }
    .desc = Это лазер для наведения артиллерии, отойди от него!
ent-RMCLaserDropshipTarget = мигающий лазер
    .desc = { ent-RMCRangefinderTarget.desc }